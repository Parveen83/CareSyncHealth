{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read All tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id = @{pipeline().parameters.adf_run_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresqldb",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "prepare email body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body header",
					"value": "Ingestion and Transformation for the caresync project has been completed and below is the status"
				}
			},
			{
				"name": "prepare email body footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body footer",
					"value": "for any support please reach out to a@gmail.com"
				}
			},
			{
				"name": "prepare email subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "check overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email body",
					"value": {
						"value": "@{pipeline().globalParameters.env}| @{if(greater(activity('check overall failed count').output.firstRow.count,0),'FAILED','SUCCESS')} | CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "check overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) from ctrl.audit_log \nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}'\nand status != 'SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresqldb",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "prepare logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Read All tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email body footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n  \"subject\": \"@{variables('email body')}\",\n  \"email_recipients\": \"@{pipeline().globalParameters.email_receipent}\",\n  \"body_header\": \"@{variables('body header')}\",\n  \"body_footer\": \"@{variables('body footer')}\",\n  \"status_table\": [activity('Read All tables status').output.value]\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a1"
			}
		},
		"variables": {
			"body header": {
				"type": "String"
			},
			"body footer": {
				"type": "String"
			},
			"email body": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}